#!/bin/sh

# /etc/config/ddns-go is a conffile: on upgrades it is kept as-is, so a
# section added in a newer package version would otherwise be missing.
# Add the alidns defaults once, without touching any existing settings.
if [ -f /etc/config/ddns-go ] && ! uci -q get ddns-go.alidns >/dev/null 2>&1; then
    uci -q batch <<'EOF'
set ddns-go.alidns=alidns
set ddns-go.alidns.enabled=0
set ddns-go.alidns.line=default
set ddns-go.alidns.apply_to=all
commit ddns-go
EOF
fi

# Both the 24.10 (opkg/.ipk) and 25.12 (apk/.apk) builds ship the same
# helpers. The web server group is normally www-data; fall back to root on
# systems that do not define it so this uci-defaults script always exits 0
# (a non-zero exit would make the package manager re-run it on every boot).
WWW_GROUP=www-data
grep -q "^${WWW_GROUP}:" /etc/group 2>/dev/null || WWW_GROUP=root
chmod +x /usr/share/rpcd/ucode/luci.ddns-go
chown "root:$WWW_GROUP" /usr/libexec/ddns-go-call
chmod 750 /usr/libexec/ddns-go-call
chown root:root /usr/libexec/ddns-go-alidns
chmod 750 /usr/libexec/ddns-go-alidns
rm -f /tmp/luci-indexcache
/etc/init.d/rpcd restart
exit 0
